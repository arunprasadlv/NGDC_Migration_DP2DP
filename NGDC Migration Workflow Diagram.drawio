        </mxCell>
        <mxCell id="s7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Consumer cuts over&lt;/b&gt;&lt;br&gt;Updates URL in weeks 1 to 3" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#C2570C;strokeColor=#C2570C;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
