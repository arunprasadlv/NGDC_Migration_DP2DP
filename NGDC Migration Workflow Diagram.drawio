        </mxCell>
        <mxCell id="g2_no" value="No: partners retest until the provider signs off" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="377" y="244" width="260" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Deploy to production&lt;/b&gt;&lt;br&gt;Pre-deployment gate met" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
