<?xml version="1.0" ?>
<mxfile host="app.diagrams.net">
  <diagram id="ngdc-workflow" name="NGDC migration workflow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Consumers cut over after sign-off, close on clean traffic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1E2761;" vertex="1" parent="1">
          <mxGeometry x="57" y="20" width="1220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Plan the wave&lt;/b&gt;&lt;br&gt;Inventory plus flight plan date" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="57" y="152" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="Date in window?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E2761;strokeWidth=2;fontColor=#1F2937;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="377" y="145" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="g1_no" value="No: propose an earlier date, else raise a CIO end-of-life risk" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="377" y="99" width="260" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Send plan to providers&lt;/b&gt;&lt;br&gt;Confirm date and backend readiness" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="697" y="152" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Create stories, reconcile&lt;/b&gt;&lt;br&gt;Flux tasks; compare heritage logs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1017" y="152" width="260" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Deploy to UAT, notify&lt;/b&gt;&lt;br&gt;One notice per consumer per wave" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1E2761;strokeColor=#1E2761;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
