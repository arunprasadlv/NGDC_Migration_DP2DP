        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Partner testing in UAT&lt;/b&gt;&lt;br&gt;Provider coordinates, consumers test" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#028090;strokeColor=#028090;fontColor=#FFFFFF;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
